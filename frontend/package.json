{
  "name": "pipeboard-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.28",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
