# docker compose と、ローカルでの実行で使う設定の見本。`.env` にコピーして使う(`.env` は git に入れない)。

# 認証: local(認証なし。自分のマシンだけで使う) または token(Bearer トークン)
PIPEBOARD_AUTH_MODE=local
# token モードのトークン。`ロール=トークン` をカンマ区切り(ロール: viewer / editor / admin)。トークンは 12 文字以上
# 例: PIPEBOARD_API_TOKENS=viewer=...,editor=...,admin=...
PIPEBOARD_API_TOKENS=

# ブラウザから API を呼べるオリジン(カンマ区切り)。`*` は明示したときだけ
PIPEBOARD_CORS_ORIGINS=http://localhost:3000

# 公開ゲート: 必須にする検査のツール名(カンマ区切り)。空ならゲートは無効
# 例: PIPEBOARD_REQUIRED_CHECKS=scene-doctor,unibridge
PIPEBOARD_REQUIRED_CHECKS=

# 変更の Webhook 通知(空なら送らない)。URL を指定したら、秘密鍵は 16 文字以上
PIPEBOARD_WEBHOOK_URL=
PIPEBOARD_WEBHOOK_SECRET=

# データベース(既定は SQLite)。PostgreSQL にする場合: postgresql+psycopg://user:password@host/dbname
# (backend/requirements-postgres.txt のドライバが要る)
# PIPEBOARD_DATABASE_URL=sqlite:////app/data/pipeboard.db

# レート制限(IP ごと、1 分あたり)。既定は読み取り 300、書き込み 60
# PIPEBOARD_RATE_LIMIT_READ_PER_MINUTE=300
# PIPEBOARD_RATE_LIMIT_WRITE_PER_MINUTE=60

# アップロードの保存先(既定は uploads/。Docker では /app/uploads をボリュームにしている)
# PIPEBOARD_UPLOAD_DIR=uploads

# デスクトップクライアント・Houdini スクリプトが API に送るトークン
PIPEBOARD_API_TOKEN=
